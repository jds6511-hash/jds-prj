      "support_span": {
        "start_seg": 261,
        "end_seg": 265
      },
      "anchor_cites": [
        261,
        263,
        265
      ],
      "summary": "두 여성은 해변에서 식사를 하고 있으며, 한 여성은 면을 먹고 있고 다른 여성은 스프를 권하고 있습니다.",
      "dialogue_note": "",
      "stt_cites": [],
      "dropped": null
    },
    {
